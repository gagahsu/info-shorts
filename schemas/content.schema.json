{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "info-shorts content",
  "type": "object",
  "required": ["id", "kind", "title", "sections"],
  "properties": {
    "id": {"type": "string"},
    "kind": {"enum": ["generic", "briefing", "company"]},
    "title": {"type": "string"},
    "subtitle": {"type": ["string", "null"]},
    "date": {"type": ["string", "null"]},
    "lang": {"type": "string", "default": "zh-TW"},
    "aspect": {"enum": ["9:16", "16:9"], "default": "9:16"},
    "target_duration": {"type": "number", "default": 45},
    "disclaimer": {"type": "boolean", "default": false},
    "bgm": {"type": ["string", "null"]},
    "sections": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {"enum": ["stat", "bullets", "table", "quote"]},
          "narration": {"type": ["string", "null"]},
          "label": {"type": "string"},
          "value": {"type": ["string", "number", "null"]},
          "delta": {"type": ["string", "number", "null"]},
          "delta_direction": {"enum": ["up", "down", "flat", null]},
          "unit": {"type": "string"},
          "heading": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string"}, "maxItems": 10},
          "columns": {"type": "array", "items": {"type": "string"}, "maxItems": 3},
          "rows": {"type": "array", "items": {"type": "array", "items": {"type": ["string", "number", "null"]}}, "maxItems": 5},
          "text": {"type": "string"},
          "source": {"type": ["string", "null"]}
        }
      }
    }
  }
}
